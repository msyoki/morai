# Moirai Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- M-Pesa (Kenya) ---
# Get these from the Safaricom Developer Portal (sandbox or production)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174479
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://moirai.netlify.net/.netlify/functions/mpesa-callback
MPESA_ENVIRONMENT=sandbox

# --- PayPal (International) ---
# Get these from the PayPal Developer Dashboard
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# --- Site ---
# Site URL used in canonical URLs and structured data
SITE_URL=https://moirai.org